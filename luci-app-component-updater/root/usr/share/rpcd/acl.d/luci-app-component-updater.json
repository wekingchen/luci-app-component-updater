{
  "luci-app-component-updater": {
    "description": "Read component status and manage explicitly approved updates",
    "read": {
      "ubus": {
        "component-updater": [
          "status",
          "check",
          "plan",
          "manager_status"
        ]
      },
      "uci": [
        "component-updater"
      ]
    },
    "write": {
      "ubus": {
        "component-updater": [
          "start",
          "rollback",
          "manager_upload",
          "manager_check",
          "manager_start",
          "manager_rollback"
        ]
      },
      "uci": [
        "component-updater"
      ],
      "cgi-io": [
        "upload"
      ],
      "file": {
        "/tmp/component-updater-manager-new.apk": [
          "write"
        ],
        "/tmp/component-updater-manager-current.apk": [
          "write"
        ]
      }
    }
  }
}
