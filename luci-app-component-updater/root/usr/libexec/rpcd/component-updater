#!/bin/sh
# rpcd executable plugin, compatible with legacy OpenWrt rpcd (no rpcd-mod-ucode).
# No caller-provided URLs, paths, or commands are forwarded.
case "$1" in
    list)
        printf '%s\n' '{"status":{},"check":{},"plan":{},"start":{},"rollback":{},"manager_status":{},"manager_upload":{"kind":"string","sha256":"string","size":"int"},"manager_check":{},"manager_start":{},"manager_rollback":{}}'
        ;;
    call)
        case "$2" in
            status|check|plan|start|rollback)
                exec /usr/sbin/component-updaterctl "$2"
                ;;
            manager_status|manager_upload|manager_check|manager_start|manager_rollback)
                case "$2" in
                    manager_status) action=status;;
                    manager_upload) action=upload;;
                    manager_check) action=check;;
                    manager_start) action=start;;
                    manager_rollback) action=rollback;;
                esac
                exec /bin/sh /usr/libexec/component-updater/manager-self-update.sh "$action"
                ;;
            *)
                printf '%s\n' '{"error":"unsupported RPC method"}'
                exit 1
                ;;
        esac
        ;;
    *) exit 1;;
esac
